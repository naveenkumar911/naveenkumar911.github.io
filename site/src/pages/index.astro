---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import RoleSwitcher from '@/components/RoleSwitcher';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import InsightCard from '@/components/InsightCard.astro';
import { site, numbers } from '@/config';
import { roles } from '@/data/roles';
import { metrics, industries } from '@/data/profile';
import { skillGroups } from '@/data/skills';

const caseStudies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
const insights = (await getCollection('insights')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const approved = (await getCollection('testimonials')).filter((t) => t.data.approved);
const testimonials = await Promise.all(approved.map(async (t) => ({ entry: t, Content: (await render(t)).Content })));

const csMeta = Object.fromEntries(caseStudies.map((c) => [c.id, { slug: c.id, title: c.data.title, summary: c.data.summary, outcomes: c.data.outcomes }]));
const inMeta = Object.fromEntries(insights.map((i) => [i.id, { slug: i.id, title: i.data.title, description: i.data.description }]));
const featured = caseStudies.filter((c) => c.data.featured).slice(0, 3);
const latest = insights.slice(0, 3);
---
<Base type="profile">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-grid"></div>
    <div class="absolute inset-0 -z-10 glow"></div>
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-16 pt-14 sm:px-6 md:grid-cols-[1.35fr_1fr] md:pb-24 md:pt-20">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="chip"><span class="h-2 w-2 rounded-full bg-accent-500"></span> Open to new roles</span>
          <span class="chip">Remote US / global</span>
          <span class="chip">Relocation</span>
          <span class="chip">UAE onsite</span>
          <span class="chip">GMT+4, US-East overlap</span>
        </div>
        <h1 class="mt-6 text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-5xl md:text-6xl">
          Agentic AI from POC to <span class="text-accent-600 dark:text-accent-400">governed production</span>, inside regulated enterprises.
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-[var(--fg-muted)] md:text-xl">
          I am Naveen Kumar, Principal AI Architect and forward-deployed AI engineering leader. Ten years embedding with government, retail, BFSI, healthcare and technology customers; today leading a 10-person AI team while still shipping the code. My engagements end with numbers on the customer's P&amp;L, not with demos.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={site.calcom} target="_blank" rel="noopener">Book a 20-minute call</a>
          <button class="btn btn-secondary" id="hero-ask">Ask my AI about fit</button>
          <a class="btn btn-ghost" href="/resume">Resume</a>
        </div>
        <p class="mt-4 text-sm text-[var(--fg-muted)]">
          Prefer a summary for the board? Read the <a class="underline" href="/executive-brief">one-page executive brief</a>.
        </p>
      </div>
      <div class="relative mx-auto w-full max-w-sm md:max-w-none">
        <div class="absolute -inset-3 -z-10 rounded-[2rem] bg-gradient-to-br from-accent-500/30 to-transparent blur-2xl"></div>
        <picture>
          <source srcset="/images/naveen-800.avif" type="image/avif" />
          <source srcset="/images/naveen-800.webp" type="image/webp" />
          <img src="/images/naveen-800.webp" width="800" height="800" alt="Naveen Kumar, Principal AI Architect" class="aspect-square w-full rounded-[2rem] object-cover shadow-2xl" fetchpriority="high" />
        </picture>
        <div class="card absolute -bottom-5 -left-3 flex items-center gap-3 px-4 py-3 text-sm shadow-lg sm:-left-6">
          <div class="text-2xl font-extrabold text-accent-600 dark:text-accent-400">10K+</div>
          <div class="leading-tight text-[var(--fg-muted)]">daily requests on a<br />government platform I built</div>
        </div>
      </div>
    </div>

    <!-- Proof bar -->
    <div class="border-y border-[var(--line)] bg-[var(--bg-elev)]/60">
      <div class="mx-auto grid max-w-6xl grid-cols-2 gap-6 px-4 py-8 sm:grid-cols-4 sm:px-6 lg:grid-cols-8">
        {metrics.map((m) => (
          <a href={m.href} class="group">
            <div class="text-2xl font-extrabold tracking-tight group-hover:text-accent-600 dark:group-hover:text-accent-400">{m.value}</div>
            <div class="text-xs text-[var(--fg-muted)] leading-tight">{m.label}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Role switcher -->
  <Section id="hire-me-as" kicker="Hire me as" title="One background, five ways to deploy it." intro="Pick the role you are hiring for. The evidence, skills and reading below adapt to it. Everything here is from delivered work.">
    <RoleSwitcher client:load roles={roles} caseStudies={csMeta} insights={inMeta} calcom={site.calcom} />
  </Section>

  <!-- Impact -->
  <Section kicker="Impact" title="Numbers with the story behind them." class="bg-[var(--bg-elev)]/40">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {metrics.map((m) => (
        <a href={m.href} class="card flex flex-col p-6 transition-colors hover:border-accent-500">
          <div class="text-4xl font-extrabold tracking-tight text-accent-600 dark:text-accent-400">{m.value}</div>
          <div class="mt-1 font-semibold">{m.label}</div>
          <p class="mt-3 text-sm text-[var(--fg-muted)] leading-relaxed">{m.story}</p>
        </a>
      ))}
    </div>
    <p class="mt-6 text-sm text-[var(--fg-muted)]">Industries: {industries.join(', ')}.</p>
  </Section>

  <!-- Case studies -->
  <Section kicker="Case studies" title="Production systems, decisions included." intro="Each case study covers context, success criteria, architecture, the decisions as ADRs, what shipped, outcomes, and what I would change.">
    <div class="grid gap-5 md:grid-cols-3">
      {featured.map((c) => <CaseStudyCard entry={c} />)}
    </div>
    <div class="mt-8">
      <a class="btn btn-secondary" href="/case-studies">All {caseStudies.length} case studies</a>
    </div>
  </Section>

  <!-- How I work -->
  <Section kicker="How I work" title="Six gates from discovery to run." intro="The engagement structure behind every outcome above. Each gate has an artifact, an owner and an exit criterion." class="bg-[var(--bg-elev)]/40">
    <div class="grid gap-4 md:grid-cols-3 lg:grid-cols-6">
      {[
        ['Discovery', 'Baseline, owner, success criterion signed by a sponsor.'],
        ['Scoped slice', 'Highest value, lowest blast radius. Golden set v1.'],
        ['Working POC', 'Real data. Metric moves. Failure modes listed.'],
        ['Production ready', 'Security, residency, evals gate, SLOs, runbooks, cost model.'],
        ['Cutover', 'Staged rollout, on-call, baseline improves in production.'],
        ['Run and expand', 'Weekly sampling, monthly review, field-to-product loop.'],
      ].map(([t, d], i) => (
        <div class="card p-5">
          <div class="text-xs font-bold text-accent-600 dark:text-accent-400">GATE {i + 1}</div>
          <div class="mt-1 font-semibold">{t}</div>
          <p class="mt-2 text-sm text-[var(--fg-muted)]">{d}</p>
        </div>
      ))}
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-secondary" href="/architecture/forward-deployed-playbook">Read the playbook</a>
      <a class="btn btn-ghost" href="/architecture">All architecture and ADRs</a>
    </div>
  </Section>

  <!-- Skills snapshot -->
  <Section kicker="Skills" title="Organised by what the market screens for in 2026." intro="Not a tool list. Each group states why it matters to hiring teams now and what I bring at depth.">
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {skillGroups.slice(0, 6).map((g) => (
        <div class="card p-6">
          <h3 class="font-bold">{g.title}</h3>
          <p class="mt-2 text-xs text-[var(--fg-muted)]">{g.demand}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {g.items.filter((i) => i.depth === 'expert').slice(0, 5).map((i) => <span class="chip">{i.name}</span>)}
          </div>
        </div>
      ))}
    </div>
    <div class="mt-8"><a class="btn btn-secondary" href="/skills">Full skills matrix</a></div>
  </Section>

  <!-- Leadership -->
  <Section kicker="Leadership" title="Built the team, set the bar, owned the outcomes." class="bg-[var(--bg-elev)]/40">
    <div class="grid gap-5 md:grid-cols-4">
      {[
        [String(numbers.teamSize), 'person team: AI engineers, data scientists, ML and AIOps'],
        [`${numbers.hired} / ${numbers.onboarded}`, 'hired / onboarded, including partner staff'],
        [String(numbers.programs), `programs owned, up to ${numbers.concurrentPrograms} concurrent`],
        ['Escalation', 'point for delivery risk, blockers and customer concerns'],
      ].map(([v, l]) => (
        <div class="card p-6">
          <div class="text-3xl font-extrabold tracking-tight">{v}</div>
          <p class="mt-2 text-sm text-[var(--fg-muted)]">{l}</p>
        </div>
      ))}
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-secondary" href="/leadership">Leadership and operating model</a>
      <a class="btn btn-ghost" href="/executive-brief">Executive brief</a>
    </div>
  </Section>

  <!-- Insights -->
  <Section kicker="Insights" title="Writing for the people who decide." intro={`Daily on LinkedIn to ${site.linkedinFollowers} followers; long-form here. Executive strategy, agentic systems in production, platform economics, governance.`}>
    <div class="grid gap-5 md:grid-cols-3">
      {latest.map((i) => <InsightCard entry={i} />)}
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-secondary" href="/insights">All {insights.length} articles</a>
      <a class="btn btn-ghost" href={site.linkedin} target="_blank" rel="noopener">Follow on LinkedIn</a>
    </div>
  </Section>

  <!-- Testimonials -->
  {testimonials.length > 0 && (
    <Section kicker="What people say" title="From the people I have worked with." class="bg-[var(--bg-elev)]/40">
      <div class="grid gap-5 md:grid-cols-2">
        {testimonials.map(({ entry: t, Content }) => (
          <figure class="card p-6">
            <blockquote class="text-[var(--fg)] leading-relaxed"><Content /></blockquote>
            <figcaption class="mt-4 text-sm text-[var(--fg-muted)]"><strong class="text-[var(--fg)]">{t.data.name}</strong>, {t.data.designation}{t.data.date ? ` (${t.data.date})` : ''}</figcaption>
          </figure>
        ))}
      </div>
    </Section>
  )}

  <!-- CTA -->
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="card relative overflow-hidden p-8 md:p-12">
        <div class="absolute inset-0 -z-10 glow"></div>
        <div class="grid items-center gap-8 md:grid-cols-[1.5fr_1fr]">
          <div>
            <h2 class="text-3xl font-bold tracking-tight md:text-4xl">If you are hiring for AI leadership or forward-deployed engineering, let us talk this week.</h2>
            <p class="mt-4 text-[var(--fg-muted)]">Twenty minutes is enough to tell whether there is a fit. I will come prepared with questions about your outcomes, not a pitch.</p>
          </div>
          <div class="flex flex-col gap-3">
            <a class="btn btn-primary" href={site.calcom} target="_blank" rel="noopener">Book a call</a>
            <a class="btn btn-secondary" href={`mailto:${site.email}`}>Email {site.email}</a>
            <a class="btn btn-secondary" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
            <a class="btn btn-ghost" href="/hire">How I engage: full-time, relocation, fractional</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  document.getElementById('hero-ask')?.addEventListener('click', () => document.dispatchEvent(new CustomEvent('open-chat')));
</script>
