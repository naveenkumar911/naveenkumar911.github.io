---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import { education } from '@/data/profile';
import { site } from '@/config';

// Add certifications here ONLY once earned. { name, issuer, date, link }
const certifications: { name: string; issuer: string; date: string; link?: string }[] = [];

const evidence = [
  { title: 'Production systems in regulated environments', detail: 'Government (UAE), Fortune 500 retail, asset management, pharmaceuticals, sports media. See case studies.', href: '/case-studies' },
  { title: 'Architecture decision records and reference architectures', detail: 'Published here with trade-offs stated. Reviewable by any hiring committee.', href: '/architecture' },
  { title: 'Live AI agent built for this site', detail: 'Governed, grounded, rate-limited, zero-cost. Interrogate it, then read the source.', href: '/case-studies/how-this-sites-ai-agent-is-built' },
  { title: 'Public writing with an audience', detail: `Daily posts to ${site.linkedinFollowers} LinkedIn followers; 18 long-form articles here.`, href: '/insights' },
  { title: 'Open-source and code', detail: 'Public repositories on GitHub covering agentic RAG, fine-tuning, MLOps and automation patterns.', href: site.github },
];
---
<Base title="Credentials | Naveen Kumar" description="Education, certifications and verifiable evidence of expertise for Naveen Kumar, Principal AI Architect.">
  <Section kicker="Credentials" title="Evidence first, certificates second." intro="At senior levels, hiring committees weigh shipped systems, written judgment and references far above certificates. This page lists what can be verified.">
    <div class="grid gap-5 md:grid-cols-2">
      {evidence.map((e) => (
        <a href={e.href} class="card p-7 transition-colors hover:border-accent-500" target={e.href.startsWith('http') ? '_blank' : undefined} rel={e.href.startsWith('http') ? 'noopener' : undefined}>
          <h3 class="h-card">{e.title}</h3>
          <p class="mt-3 text-base leading-relaxed text-[var(--fg-muted)]">{e.detail}</p>
        </a>
      ))}
    </div>
  </Section>

  <Section kicker="Education" title="Formal education." class="bg-[var(--bg-elev)]/40">
    {education.map((e) => (
      <div class="card p-7">
        <h3 class="h-card">{e.degree}</h3>
        <p class="mt-2 text-lg text-[var(--fg-muted)]">{e.school}{e.note ? ` · ${e.note}` : ''}</p>
      </div>
    ))}
  </Section>

  <Section kicker="Certifications" title="Certifications.">
    {certifications.length > 0 ? (
      <div class="grid gap-5 md:grid-cols-2">
        {certifications.map((c) => (
          <div class="card p-7">
            <h3 class="font-bold">{c.name}</h3>
            <p class="mt-1 text-sm text-[var(--fg-muted)]">{c.issuer} · {c.date}</p>
            {c.link && <a class="mt-2 inline-block text-sm underline" href={c.link} target="_blank" rel="noopener">Verify</a>}
          </div>
        ))}
      </div>
    ) : (
      <div class="card p-7">
        <p class="text-lg text-[var(--fg-muted)]">Certifications are listed here with verification links as they are earned. My expertise is evidenced by the production systems, architecture decisions and writing on this site, and by references available at offer stage.</p>
      </div>
    )}
  </Section>
</Base>
