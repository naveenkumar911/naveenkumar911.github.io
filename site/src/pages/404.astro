---
import Base from '@/layouts/Base.astro';
import { site } from '@/config';
---
<Base title="Page not found | Naveen Kumar" description="That page does not exist." noindex>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
    <p class="text-xs font-semibold uppercase tracking-wider text-accent-600 dark:text-accent-400">404</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight">That page is not here.</h1>
    <p class="mt-4 text-[var(--fg-muted)]">Probably a moved article or a typo. The useful places are below.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-secondary" href="/case-studies">Case studies</a>
      <a class="btn btn-secondary" href="/insights">Insights</a>
      <a class="btn btn-secondary" href={site.calcom} target="_blank" rel="noopener">Book a call</a>
    </div>
  </section>
</Base>
