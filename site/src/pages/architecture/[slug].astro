---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Mermaid from '@/components/Mermaid.astro';
import { site } from '@/config';

export async function getStaticPaths() {
  const items = await getCollection('architecture');
  return items.map((a) => ({ params: { slug: a.id }, props: { entry: a } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const others = (await getCollection('architecture')).filter((a) => a.id !== entry.id).sort((a, b) => a.data.order - b.data.order);
const kindLabel: Record<string, string> = {
  'reference-architecture': 'Reference architecture',
  playbook: 'Playbook',
  adr: 'Architecture decision record',
  framework: 'Framework',
  methodology: 'Methodology',
};
---
<Base title={`${d.title} | Architecture`} description={d.summary} type="article">
  <div class="page py-12 md:py-16">
    <article>
      <nav class="text-base text-[var(--fg-muted)]"><a class="hover:underline" href="/architecture">Architecture</a> / {kindLabel[d.kind]}</nav>
      <p class="kicker mt-5">{kindLabel[d.kind]}</p>
      <h1 class="mt-3 max-w-5xl text-4xl font-extrabold leading-[1.05] tracking-tight md:text-5xl xl:text-6xl">{d.title}</h1>
      <p class="lead mt-6 max-w-4xl">{d.summary}</p>
      <p class="mt-4"><span class="chip">Status: {d.status}</span></p>
      <div class="prose-site prose-breakout mt-10"><Content /></div>
      <div class="mt-12 flex flex-wrap gap-3 no-print">
        <a class="btn btn-primary" href={site.calcom} target="_blank" rel="noopener">Walk through this with me</a>
        <a class="btn btn-secondary" href="/case-studies">See it applied in case studies</a>
      </div>
    </article>
    <aside class="mt-16 border-t border-[var(--line)] pt-10">
      <h2 class="text-3xl font-extrabold tracking-tight">More architecture</h2>
      <ul class="mt-6 grid gap-4 text-base sm:grid-cols-2 lg:grid-cols-3">
        {others.map((a) => (
          <li class="card p-6"><a class="text-lg font-bold hover:underline" href={`/architecture/${a.id}`}>{a.data.title}</a><div class="mt-2 text-sm text-[var(--fg-muted)]">{kindLabel[a.data.kind]}</div></li>
        ))}
      </ul>
    </aside>
  </div>
  <Mermaid />
</Base>
