---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Mermaid from '@/components/Mermaid.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import { site } from '@/config';

export async function getStaticPaths() {
  const items = await getCollection('caseStudies');
  return items.map((c) => ({ params: { slug: c.id }, props: { entry: c } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const all = (await getCollection('caseStudies')).filter((c) => c.id !== entry.id).sort((a, b) => a.data.order - b.data.order);
const related = all.filter((c) => c.data.tracks.some((t) => d.tracks.includes(t))).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.summary,
  author: { '@type': 'Person', name: site.name, url: site.url },
  about: d.industry,
};
---
<Base title={`${d.title} | Case study`} description={d.summary} image="/og/case-studies.png" type="article" jsonLd={jsonLd}>
  <article class="page py-12 md:py-16">
    <nav class="text-base text-[var(--fg-muted)]"><a class="hover:underline" href="/case-studies">Case studies</a> / {d.industry}</nav>
    <header class="mt-5 grid gap-10 lg:grid-cols-[1.6fr_1fr]">
      <div>
        <p class="kicker">Case study · {d.industry}</p>
        <h1 class="mt-3 text-4xl font-extrabold leading-[1.05] tracking-tight md:text-5xl xl:text-6xl">{d.title}</h1>
        <p class="lead mt-6">{d.summary}</p>
        <dl class="mt-8 grid gap-5 text-base sm:grid-cols-3">
          <div><dt class="text-sm font-bold uppercase tracking-[0.14em] text-[var(--fg-muted)]">Client</dt><dd class="mt-1 font-semibold">{d.client}</dd></div>
          <div><dt class="text-sm font-bold uppercase tracking-[0.14em] text-[var(--fg-muted)]">Role</dt><dd class="mt-1 font-semibold">{d.role}</dd></div>
          <div><dt class="text-sm font-bold uppercase tracking-[0.14em] text-[var(--fg-muted)]">Period</dt><dd class="mt-1 font-semibold">{d.period}</dd></div>
        </dl>
      </div>
      <aside class="card p-7">
        <h2 class="text-sm font-bold uppercase tracking-[0.14em] text-[var(--fg-muted)]">Outcomes</h2>
        <div class="mt-5 grid grid-cols-2 gap-5">
          {d.outcomes.map((o) => (
            <div>
              <div class="text-3xl font-extrabold tracking-tight text-accent-600 dark:text-accent-400">{o.value}</div>
              <div class="mt-1 text-sm text-[var(--fg-muted)] leading-tight">{o.label}</div>
            </div>
          ))}
        </div>
        <h2 class="mt-7 text-sm font-bold uppercase tracking-[0.14em] text-[var(--fg-muted)]">Stack</h2>
        <div class="mt-3 flex flex-wrap gap-2">{d.stack.map((s) => <span class="chip">{s}</span>)}</div>
        <a class="btn btn-primary mt-6 w-full" href={site.calcom} target="_blank" rel="noopener">Discuss this work</a>
      </aside>
    </header>

    <div class="prose-site prose-breakout mt-12">
      <Content />
    </div>

    {related.length > 0 && (
      <section class="mt-16 border-t border-[var(--line)] pt-10">
        <h2 class="text-3xl font-extrabold tracking-tight">Related case studies</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-3">{related.map((c) => <CaseStudyCard entry={c} compact />)}</div>
      </section>
    )}
  </article>
  <Mermaid />
</Base>
