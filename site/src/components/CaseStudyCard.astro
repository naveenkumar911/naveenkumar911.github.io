---
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'caseStudies'>; compact?: boolean }
const { entry, compact = false } = Astro.props;
const d = entry.data;
---
<a href={`/case-studies/${entry.id}`} class="card group flex h-full flex-col p-6 transition-colors hover:border-accent-500">
  <p class="text-xs font-semibold uppercase tracking-wider text-[var(--fg-muted)]">{d.industry}</p>
  <h3 class="mt-2 text-lg font-bold leading-snug group-hover:text-accent-600 dark:group-hover:text-accent-400">{d.title}</h3>
  {!compact && <p class="mt-3 text-sm text-[var(--fg-muted)] leading-relaxed line-clamp-4">{d.summary}</p>}
  <div class="mt-4 grid grid-cols-3 gap-3">
    {d.outcomes.slice(0, 3).map((o) => (
      <div>
        <div class="text-base font-extrabold tracking-tight">{o.value}</div>
        <div class="text-xs text-[var(--fg-muted)] leading-tight">{o.label}</div>
      </div>
    ))}
  </div>
  <div class="mt-auto pt-4 text-xs text-[var(--fg-muted)]">{d.client}</div>
</a>
