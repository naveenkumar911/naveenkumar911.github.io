---
import { site, nav } from '@/config';
import ThemeToggle from '@/components/ThemeToggle.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const clean = href.split('#')[0].replace(/\/$/, '') || '/';
  return clean !== '/' && path.startsWith(clean);
};
---
<header class="sticky top-0 z-50 border-b border-[var(--line)] bg-[var(--bg)]/85 backdrop-blur no-print">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 font-bold tracking-tight">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-accent-500 text-ink-950 font-extrabold">NK</span>
      <span class="hidden sm:inline">{site.name}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {nav.map((n) => (
        <a
          href={n.href}
          class={`rounded-lg px-3 py-2 text-sm font-medium transition-colors hover:text-[var(--fg)] ${isActive(n.href) ? 'text-[var(--fg)]' : 'text-[var(--fg-muted)]'}`}
          aria-current={isActive(n.href) ? 'page' : undefined}
        >{n.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a href={site.calcom} target="_blank" rel="noopener" class="btn btn-primary hidden sm:inline-flex !py-2 !px-4 text-sm">Book a call</a>
      <button id="nav-toggle" class="btn btn-secondary md:hidden !p-2" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-[var(--line)] md:hidden">
    <nav class="mx-auto flex max-w-6xl flex-col px-4 py-3" aria-label="Mobile">
      {nav.map((n) => (
        <a href={n.href} class="rounded-lg px-3 py-3 text-base font-medium text-[var(--fg-muted)] hover:text-[var(--fg)]">{n.label}</a>
      ))}
      <a href="/resume" class="rounded-lg px-3 py-3 text-base font-medium text-[var(--fg-muted)] hover:text-[var(--fg)]">Resume</a>
      <a href={site.calcom} target="_blank" rel="noopener" class="btn btn-primary mt-2">Book a call</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
