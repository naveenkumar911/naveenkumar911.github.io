---
import { site, nav } from '@/config';
import ThemeToggle from '@/components/ThemeToggle.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const clean = href.split('#')[0].replace(/\/$/, '') || '/';
  return clean !== '/' && path.startsWith(clean);
};
---
<header class="sticky top-0 z-50 border-b border-[var(--line)] bg-[var(--bg)]/85 backdrop-blur no-print">
  <div class="page flex h-16 items-center justify-between gap-4 md:h-20">
    <a href="/" class="flex items-center gap-3 font-extrabold tracking-tight">
      <span class="grid h-10 w-10 place-items-center rounded-xl bg-accent-500 text-lg text-ink-950 font-extrabold">NK</span>
      <span class="text-lg sm:text-xl lg:hidden xl:inline">{site.name}</span>
    </a>

    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Primary">
      {nav.map((n) => (
        <a
          href={n.href}
          class={`rounded-xl px-3 py-2.5 text-base font-semibold transition-colors hover:bg-[var(--bg-elev)] hover:text-[var(--fg)] xl:px-4 xl:text-[1.0625rem] ${isActive(n.href) ? 'text-[var(--fg)]' : 'text-[var(--fg-muted)]'}`}
          aria-current={isActive(n.href) ? 'page' : undefined}
        >{n.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <ThemeToggle />
      <a href={site.calcom} target="_blank" rel="noopener" class="btn btn-primary hidden sm:inline-flex !min-h-0 !py-2.5 !px-5">Book a call</a>
      <button id="nav-toggle" class="btn btn-secondary lg:hidden !min-h-11 !min-w-11 !p-2.5" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <svg class="nav-open-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="nav-close-icon hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- Outside the header: backdrop-filter would otherwise trap this fixed panel inside the header box. -->
<div id="mobile-nav" class="fixed inset-x-0 bottom-0 top-16 z-[70] hidden overflow-y-auto bg-[var(--bg)] md:top-20 lg:hidden no-print">
  <nav class="page flex flex-col py-4" aria-label="Mobile">
    {nav.map((n) => (
      <a href={n.href} class={`flex min-h-14 items-center justify-between border-b border-[var(--line)] px-1 text-xl font-bold ${isActive(n.href) ? 'text-accent-600 dark:text-accent-400' : 'text-[var(--fg)]'}`}>
        {n.label}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--fg-muted)]" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      </a>
    ))}
    <a href="/leadership" class="flex min-h-14 items-center border-b border-[var(--line)] px-1 text-lg font-semibold text-[var(--fg-muted)]">Leadership</a>
    <a href="/architecture" class="flex min-h-14 items-center border-b border-[var(--line)] px-1 text-lg font-semibold text-[var(--fg-muted)]">Architecture</a>
    <div class="mt-6 grid grid-cols-2 gap-3">
      <a href={site.calcom} target="_blank" rel="noopener" class="btn btn-primary btn-lg col-span-2">Book a 20-minute call</a>
      <a href={site.resumePdf} download class="btn btn-secondary">Resume PDF</a>
      <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="btn btn-secondary">WhatsApp</a>
    </div>
    <p class="mt-6 text-sm text-[var(--fg-muted)]">{site.joinerStatus} &middot; {site.email}</p>
  </nav>
</div>

<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    document.documentElement.classList.toggle('nav-open', open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    btn?.querySelector('.nav-open-icon')?.classList.toggle('hidden', open);
    btn?.querySelector('.nav-close-icon')?.classList.toggle('hidden', !open);
  };
  btn?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
</script>
