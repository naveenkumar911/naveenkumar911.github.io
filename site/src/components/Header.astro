---
import { site, nav } from '@/config';
import ThemeToggle from '@/components/ThemeToggle.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const clean = href.split('#')[0].replace(/\/$/, '') || '/';
  return clean !== '/' && path.startsWith(clean);
};
---
<header class="sticky top-0 z-50 border-b border-[var(--line)] bg-[var(--bg)]/85 backdrop-blur no-print">
  <div class="page flex h-20 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3 font-extrabold tracking-tight">
      <span class="grid h-10 w-10 place-items-center rounded-xl bg-accent-500 text-lg text-ink-950 font-extrabold">NK</span>
      <span class="hidden text-xl sm:inline">{site.name}</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {nav.map((n) => (
        <a
          href={n.href}
          class={`rounded-xl px-4 py-2.5 text-[1.0625rem] font-semibold transition-colors hover:bg-[var(--bg-elev)] hover:text-[var(--fg)] ${isActive(n.href) ? 'text-[var(--fg)]' : 'text-[var(--fg-muted)]'}`}
          aria-current={isActive(n.href) ? 'page' : undefined}
        >{n.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <ThemeToggle />
      <a href={site.calcom} target="_blank" rel="noopener" class="btn btn-primary hidden sm:inline-flex !py-2.5 !px-5">Book a call</a>
      <button id="nav-toggle" class="btn btn-secondary lg:hidden !p-2.5" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-[var(--line)] lg:hidden">
    <nav class="page flex flex-col py-3" aria-label="Mobile">
      {nav.map((n) => (
        <a href={n.href} class="rounded-xl px-3 py-3 text-lg font-semibold text-[var(--fg-muted)] hover:text-[var(--fg)]">{n.label}</a>
      ))}
      <a href="/resume" class="rounded-xl px-3 py-3 text-lg font-semibold text-[var(--fg-muted)] hover:text-[var(--fg)]">Resume</a>
      <a href={site.calcom} target="_blank" rel="noopener" class="btn btn-primary mt-2">Book a call</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
