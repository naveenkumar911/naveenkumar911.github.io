---
interface Props {
  id?: string;
  kicker?: string;
  title: string;
  intro?: string;
  class?: string;
  wide?: boolean;
}
const { id, kicker, title, intro, class: cls = '' } = Astro.props;
---
<section id={id} class={`py-12 md:py-20 lg:py-24 ${cls}`}>
  <div class="page">
    <div class="max-w-4xl">
      {kicker && <p class="kicker">{kicker}</p>}
      <h2 class="h-section mt-2 md:mt-3">{title}</h2>
      {intro && <p class="lead mt-3 md:mt-5">{intro}</p>}
    </div>
    <div class="mt-7 md:mt-10 lg:mt-12">
      <slot />
    </div>
  </div>
</section>
