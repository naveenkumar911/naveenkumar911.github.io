---
import { site } from '@/config';
// Cal.com inline embed (loads only when this component is on the page). Falls back to a link.
const path = new URL(site.calcom).pathname.replace(/^\//, '');
---
<div class="card overflow-hidden">
  <div class="flex items-center justify-between border-b border-[var(--line)] px-5 py-3">
    <div class="font-semibold">Book a 20-minute intro call</div>
    <a class="text-sm underline" href={site.calcom} target="_blank" rel="noopener">Open in Cal.com</a>
  </div>
  <div id="cal-inline" class="min-h-[560px]" data-cal-link={path}></div>
</div>
<script>
  // Official Cal.com embed snippet, trimmed. See https://cal.com/docs/developing/guides/embeds
  (function (C: any, A: string, L: string) {
    const p = function (a: any, ar: any) { a.q.push(ar); };
    const d = C.document;
    C.Cal = C.Cal || function () {
      const cal = C.Cal; const ar = arguments;
      if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement('script')).src = A; cal.loaded = true; }
      if (ar[0] === L) {
        const api: any = function () { p(api, arguments); };
        const namespace = ar[1]; api.q = api.q || [];
        if (typeof namespace === 'string') { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ['initNamespace', namespace]); } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window as any, 'https://app.cal.com/embed/embed.js', 'init');
  const Cal = (window as any).Cal;
  const el = document.getElementById('cal-inline');
  const link = el?.getAttribute('data-cal-link') || '';
  const dark = document.documentElement.classList.contains('dark');
  Cal('init', 'intro', { origin: 'https://cal.com' });
  Cal.ns.intro('inline', { elementOrSelector: '#cal-inline', calLink: link, layout: 'month_view' });
  Cal.ns.intro('ui', { theme: dark ? 'dark' : 'light', hideEventTypeDetails: false, layout: 'month_view' });
</script>
