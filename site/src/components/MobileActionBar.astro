---
/** Phone-only sticky bar: the four actions a recruiter takes on mobile, always one tap away. */
import { site } from '@/config';
const actions = [
  { href: site.resumePdf, label: 'Resume', download: true, icon: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M12 12v6M9 15l3 3 3-3"/>' },
  { href: `https://wa.me/${site.whatsapp}`, label: 'WhatsApp', external: true, icon: '<path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z"/>' },
  { href: `mailto:${site.email}?subject=Role%20discussion`, label: 'Email', icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>' },
  { href: `tel:${site.phoneUAE.replace(/\s/g, '')}`, label: 'Call', icon: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.6a2 2 0 0 1-.5 2.1L8.1 9.7a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.8.3 1.7.5 2.6.7a2 2 0 0 1 1.9 2z"/>' },
];
---
<nav class="mobile-bar no-print md:hidden" aria-label="Quick contact">
  {actions.map((a, i) => (
    <a
      href={a.href}
      class={i === 0 ? 'mobile-bar-primary' : ''}
      download={a.download ? '' : undefined}
      target={a.external ? '_blank' : undefined}
      rel={a.external ? 'noopener' : undefined}
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={a.icon}></svg>
      <span>{a.label}</span>
    </a>
  ))}
</nav>
