---
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'insights'> }
const { entry } = Astro.props;
const d = entry.data;
const trackLabel: Record<string, string> = {
  executive: 'Executive and CAIO',
  agentic: 'Agentic AI in production',
  platform: 'Platform, cost and sovereignty',
  leadership: 'Leadership and hiring',
};
const words = entry.body ? entry.body.split(/\s+/).length : 800;
const minutes = Math.max(3, Math.round(words / 220));
const date = d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<a href={`/insights/${entry.id}`} class="card group flex h-full flex-col p-7 transition-colors hover:border-accent-500">
  <div class="flex items-center justify-between gap-3 text-sm text-[var(--fg-muted)]">
    <span class="font-bold uppercase tracking-[0.14em] text-accent-600 dark:text-accent-400">{trackLabel[d.track]}</span>
    <span>{minutes} min</span>
  </div>
  <h3 class="h-card mt-4 group-hover:text-accent-600 dark:group-hover:text-accent-400">{d.title}</h3>
  <p class="mt-4 text-base leading-relaxed text-[var(--fg-muted)] line-clamp-3">{d.description}</p>
  <div class="mt-auto flex items-center justify-between pt-5 text-sm text-[var(--fg-muted)]">
    <span>{date}</span>
    {d.linkedin && <span class="chip !py-0.5 !px-2.5 !text-xs">From LinkedIn</span>}
  </div>
</a>
