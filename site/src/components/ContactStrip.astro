---
/**
 * Immediate-joiner status plus every direct contact route on one line, so a recruiter can act
 * without scrolling. Used in the hero, at the top of the Hire page and in the executive brief.
 */
import { site } from '@/config';
interface Props { compact?: boolean; class?: string; showBook?: boolean }
const { compact = false, class: cls = '', showBook = true } = Astro.props;
const linkedinHandle = site.linkedin.replace(/^https?:\/\/(www\.)?/, '');
---
<div class={`contact-strip ${compact ? 'contact-strip-compact' : ''} ${cls}`}>
  <span class="chip chip-gold" title="Available to start right away">
    <span class="relative flex h-2.5 w-2.5">
      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-gold-400 opacity-75"></span>
      <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-gold-500"></span>
    </span>
    {site.joinerStatus}
  </span>
  <a class="contact-link" href={`mailto:${site.email}?subject=Role%20discussion`} title="Email">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
    <span>{site.email}</span>
  </a>
  <a class="contact-link" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" title="Call or WhatsApp">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.6a2 2 0 0 1-.5 2.1L8.1 9.7a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.8.3 1.7.5 2.6.7a2 2 0 0 1 1.9 2z"/></svg>
    <span>{site.phoneUAE} <span class="text-[var(--fg-muted)]">(call / WhatsApp)</span></span>
  </a>
  <a class="contact-link" href={site.linkedin} target="_blank" rel="noopener" title="LinkedIn">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.4 20.4h-3.5v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9v5.7H9.4V9h3.4v1.6c.5-.9 1.6-1.9 3.3-1.9 3.6 0 4.2 2.4 4.2 5.4v6.3zM5.3 7.4a2 2 0 1 1 0-4.1 2 2 0 0 1 0 4.1zM7.1 20.4H3.6V9h3.5v11.4zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.5c0 1 .8 1.8 1.8 1.8h20.4c1 0 1.8-.8 1.8-1.8V1.7C24 .8 23.2 0 22.2 0z"/></svg>
    <span>{linkedinHandle}</span>
  </a>
  {showBook && (
    <a class="contact-link contact-link-accent" href={site.calcom} target="_blank" rel="noopener" title="Book a 20-minute call">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
      <span>Book 20 min</span>
    </a>
  )}
</div>
