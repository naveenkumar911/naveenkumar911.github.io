---
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ChatLauncher from '@/components/ChatLauncher.astro';
import { site } from '@/config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  hideChat?: boolean;
  bodyClass?: string;
}

const { hideChat = false, bodyClass = '', ...seo } = Astro.props;
---
<!doctype html>
<html lang="en" class="scroll-smooth dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0c17" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f7fb" media="(prefers-color-scheme: light)" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={site.name} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      // Dark is the default. Only an explicit user choice of light overrides it.
      (function () {
        try {
          if (localStorage.getItem('theme') === 'light') document.documentElement.classList.remove('dark');
        } catch (e) {}
      })();
    </script>
    <SEO {...seo} />
    {site.goatcounter && (
      <script is:inline data-goatcounter={site.goatcounter} async src="https://gc.zgo.at/count.js"></script>
    )}
  </head>
  <body class={`min-h-screen flex flex-col ${bodyClass}`}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] btn btn-primary">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    {!hideChat && <ChatLauncher />}
  </body>
</html>
